# Copy to .env.local to override. Only NEXT_PUBLIC_* values are exposed to the browser,
# so never put secrets here. Gemini credentials belong in the backend's .env only.

# Base URL for API calls. "/api" uses the Vite dev proxy below, which is required
# because the FastAPI backend does not send CORS headers.
NEXT_PUBLIC_API_BASE_URL=/api

# Swagger UI link in the footer.
NEXT_PUBLIC_API_DOCS_URL=http://127.0.0.1:8000/docs

# Where the dev proxy forwards /api (dev server only; not exposed to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000
